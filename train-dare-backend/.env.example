NODE_ENV=development
PORT=3001

# Security
# Required in production: generate an independent random secret (at least 32 characters).
JWT_SECRET=
JWT_EXPIRES_IN=604800
# Optional private Netlify Build Hook. Configure the real value only on Render.
NETLIFY_BUILD_HOOK=
# Required in production JSON mode; MongoDB mode uses active database accounts only.
ADMIN_USERNAME=
# At least 12 characters in production; no admin/password/changeme default.
ADMIN_PASSWORD=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=train_dare_academy
MONGODB_AUTO_INDEX=true
MONGODB_REQUIRED=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
